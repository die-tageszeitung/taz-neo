<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/backgroundColor">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentScrim="@color/backgroundColor"
            app:expandedTitleGravity="top"
            app:layout_scrollFlags="scroll|enterAlways|snap"
            app:scrimAnimationDuration="0">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/listen_header"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/backgroundColor"
                app:contentInsetEnd="0dp"
                app:contentInsetStart="0dp" />

            <LinearLayout
                android:id="@+id/listen_tabs_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginHorizontal="@dimen/fragment_header_default_margin_horizontal"
                android:layout_marginTop="@dimen/fragment_header_default_padding_top"
                android:layout_marginBottom="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/tab_podcasts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="start|bottom">

                    <ImageView
                        android:id="@+id/tab_podcasts_icon"
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_listen"
                        app:iconTint="@color/tab_icon_tint"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tab_podcasts_text"
                        style="@style/Widget.App.Header.Default.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/fragment_header_icon_margin"
                        android:text="@string/tab_bar_listen_podcasts"
                        android:textColor="@color/tab_icon_tint"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tab_podcasts_icon" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/tab_playlist"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="start|bottom">

                    <ImageView
                        android:id="@+id/tab_playlist_icon"
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_playlist_outlined"
                        app:iconTint="@color/tab_icon_tint"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <TextView
                        android:id="@+id/tab_playlist_text"
                        style="@style/Widget.App.Header.Default.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/fragment_header_icon_margin"
                        android:text="@string/tab_bar_listen_playlist"
                        android:textColor="@color/tab_icon_tint"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tab_playlist_icon" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>

            <de.taz.app.android.ui.DottedLineView
                android:id="@+id/dotted_line"
                android:layout_width="match_parent"
                android:layout_height="@dimen/fragment_header_dotted_line_height"
                android:layout_gravity="bottom"
                android:layout_marginHorizontal="@dimen/fragment_header_default_margin_horizontal"
                android:importantForAccessibility="no"
                app:color="@color/textColor" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/listen_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
