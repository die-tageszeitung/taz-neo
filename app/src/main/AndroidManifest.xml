<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="auto">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".TazApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <receiver
            android:name=".widget.MomentWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/moment_widget_info" />
        </receiver>

        <activity
            android:name=".ui.WelcomeActivity"
            android:noHistory="true" />
        <activity
            android:name=".ui.WebViewActivity"
            android:noHistory="true" />
        <activity android:name=".ui.StorageOrganizationActivity" />
        <activity
            android:name=".ui.ImagePagerActivity"
            android:configChanges="orientation|screenSize"
            android:noHistory="true" />
        <!--
            Using windowSoftInputMode=adjustNothing to prevent errors with the CoverFlow when the
            SubscriptionElapsedBottomSheetFragment has been viewed. See the discussions at
            https://gitlab.alt.coop/taz/taz-app/-/issues/149 and
            https://gitlab.alt.coop/taz/taz-app/-/merge_requests/1219 for further information.

            WARNING: This will apply to all text input fields within the MainActivity.
                     Currently there is no other, but be careful when adding another.
        -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:theme="@style/noAnimationOnActivityChange"
            android:windowSoftInputMode="stateHidden|adjustNothing" />
        <activity
            android:name=".ui.search.SearchActivity"
            android:theme="@style/noAnimationOnActivityChange"
            android:windowSoftInputMode="stateHidden|adjustPan" />
        <activity
            android:name=".ui.bookmarks.BookmarkListActivity"
            android:theme="@style/noAnimationOnActivityChange" />
        <activity
            android:name=".ui.bookmarks.BookmarkViewerActivity"
            android:theme="@style/noAnimationOnActivityChange" />
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:theme="@style/noAnimationOnActivityChange" />
        <activity
            android:name=".ui.settings.ErrorReportActivity"
            android:theme="@style/noAnimationOnActivityChange" />
        <activity
            android:name=".ui.listen.ListenActivity"
            android:theme="@style/noAnimationOnActivityChange" />
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/SplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.UrlCatcherActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/SplashTheme">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="${deepLinkSchema}" />
                <data android:scheme="${deepLinkSchema2}" />
                <data android:host="${deepLinkHost}" />
                <data android:host="www.${deepLinkHost}" />
                <data android:host="epaper.${deepLinkHost}" />

                <data android:path="/\\!0*" />
                <data android:path="/\\!1*" />
                <data android:path="/\\!2*" />
                <data android:path="/\\!3*" />
                <data android:path="/\\!4*" />
                <data android:path="/\\!5*" />
                <data android:path="/\\!6*" />
                <data android:path="/\\!7*" />
                <data android:path="/\\!8*" />
                <data android:path="/\\!9*" />
                <data android:pathAdvancedPattern="/\\![0-9]*" />
            </intent-filter>

        </activity>

        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />

        <uses-library
            android:name="android.test.runner"
            android:required="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.contentProvider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <service
            android:name=".audioPlayer.ArticleAudioMediaSessionService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <package android:name="de.taz.taz.newsapp" />
    </queries>
</manifest>